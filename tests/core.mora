language mora 0.3

bring "../src/geometry.mora"
bring "../src/emotion.mora"

scenario "repeated correction creates evidence, not certainty" {
    given user is near neutral
    given frame A is valid EditableFrame

    perceive correction(A)
    perceive correction(A)
    perceive correction(A)

    expect user.frustrated rose
    expect user.uncertain rose
    expect user belief remains uncertain
    expect pattern user struggles with A may hold
}

scenario "successful flow withdraws intrusive help" {
    given PreciseEditing is offered
    given user.confident dominates for 8s

    perceive user flows

    expect PreciseEditing withdrawn
}

scenario "geometry is constrained by laws" {
    given frame A is valid EditableFrame

    attempt move corner of A outside scan

    expect EditableFrame still holds
    expect A remains convex
}
