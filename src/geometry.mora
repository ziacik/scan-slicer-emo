faculty geometry from opencv {
    can centered-quad Image WidthFraction HeightFraction -> Quad
    can expand-each Quads Pixels Image -> Quads
    can perspective-crop Image Quad -> Image
    can move Quad Dx Dy Image -> Quad
    can move-corner Quad Corner Dx Dy Image Snap -> Quad
    can move-edge Quad Edge Dx Dy Image Snap -> Quad
    can filter Quads Image MinSide MinArea MaxArea MaxTouchedEdges EdgeFraction -> Quads
    can dedupe Quads Threshold -> Quads
    can sort-visual Quads RowHeight -> Quads
    can bounds Quad -> Rect
    can contains Point Quad -> Bool
}

law EditableRegion {
    shape is convex Quad
    every edge longer than 20px
    every point remains inside source image
    moving an edge preserves its vector
}

preference SafeCrop {
    losing source pixels hurts strongly
    keeping narrow scanner background hurts faintly
}
