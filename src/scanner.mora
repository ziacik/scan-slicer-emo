faculty scanner from sane {
    can discover scanners
    can acquire Image from Scanner at Dpi
}

desire ScanImage {
    ask user for scanner among scanner.discover
    ask user for dpi default 600

    attempt scanner.acquire chosen scanner at chosen dpi

    fulfilled with image {
        remember scan as {
            image  image
            source scanner
        }
        perceive scan arrived
    }

    thwarted by error {
        perceive failure named "scan" carrying error
        tell user "Scan failed"
    }
}
