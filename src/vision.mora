faculty vision from openai.responses {
    model "gpt-5.6-terra"

    secret api-key in system-keyring
    ask-user when missing
}

concept PhysicalPhoto {
    a separate photographic print lying on the scanned surface
    not content depicted inside a photograph
    not the scanner or page boundary

    has four outer corners
    may be faded, damaged, low-contrast or rotated
}

desire DetectPhotos {
    requires scan

    ask vision to perceive PhysicalPhoto in scan.image {
        detail high
        coordinates normalized 0..1000
        corners clockwise from visually top-left
    }

    trust vision at 0.72

    fulfilled with candidates {
        believe frames are candidates
        expanded by padding
        rejecting scanner-boundary lookalikes
        merging near-duplicates

        remember frames
        forget selection
        perceive detection succeeded
    }

    thwarted by error {
        perceive failure named "detection" carrying error
        tell user "Photo detection failed"
    }
}

when user corrects frame {
    lower trust in that frame
}

when user deletes detected frame {
    strongly lower trust in that frame
}

when user adds missing frame {
    perceive vision omission
    lower trust in current detection moderately
}
