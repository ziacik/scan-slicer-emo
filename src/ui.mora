faculty desktop from gtk4 + libadwaita {
    can show Window
    can show Header
    can show Sidebar
    can show Canvas
    can show Toast
    can bind gestures
    can render Image
    can render Quad
    can render Magnifier
}

scene Main {
    window {
        title "Scan Slicer Emo"
        size 1200 x 820
        minimum 780 x 520

        header {
            button Scan   icon scanner-symbolic       invites ScanImage
            button Open   icon document-open-symbolic invites OpenScan
            button Detect icon system-search-symbolic invites DetectPhotos

            button Undo   icon edit-undo-symbolic     invites Undo
            button Redo   icon edit-redo-symbolic     invites Redo
            button Fit    icon zoom-fit-best-symbolic invites FitView

            button Export emphasized                  invites ExportPhotos
        }

        sidebar {
            group "Source" {
                show scan.source or "No scan loaded"
                show scan.dimensions when scan exists
            }

            group "Frames" {
                show count(frames)
                button Add    invites AddFrame
                button Delete invites DeleteFrame when selection exists
                show selection.dimensions when selection exists
            }

            group "Crop" {
                control padding from 0px to 100px
            }

            group "Adaptive assistance" {
                reveal user belief only as {
                    "Normal assistance" when user flows
                    "Precise assistance" when user struggles with current frame
                    "Learning your editing rhythm" otherwise
                }
            }

            group "View" {
                show view.zoom
            }

            tell latest message
        }

        canvas Editor {
            background follows system theme

            when no scan {
                offer Empty {
                    icon scanner-symbolic
                    title "Open or scan an image"
                    action "Scan from Scanner…" invites ScanImage
                    action "Open Image…" invites OpenScan
                }
            }

            when scan exists {
                show scan.image fitted through view
                overlay every frame as quadrilateral

                focused frame {
                    handles on corners
                    handles on edges

                    handle size responds to Editing
                    snapping responds to Editing
                }

                gesture click frame {
                    focus frame
                }

                gesture drag empty-space {
                    pan view
                }

                gesture drag unfocused frame {
                    focus frame
                    pan view
                }

                gesture drag focused frame {
                    move frame respecting EditableFrame
                }

                gesture drag focused frame.corner {
                    move corner respecting EditableFrame
                }

                gesture drag focused frame.edge {
                    move edge preserving vector
                    respecting EditableFrame
                }

                gesture wheel {
                    zoom view around pointer
                    perceive zooming
                }

                while dragging and PreciseEditing offered {
                    show Magnifier around pointer
                }
            }
        }
    }
}

when app starts {
    present Main
}
