faculty desktop from gtk4 + libadwaita {
    can show Window
    can show Sidebar
    can show Canvas
    can bind gestures
}

scene Main {
    window {
        title "Scan Slicer Emo"
        size 1200 x 820
        minimum 780 x 520

        header {
            button Scan icon scanner-symbolic invites AcquireImage
            button Open icon document-open-symbolic invites OpenImage
            button Detect icon system-search-symbolic invites DetectRegions when scan.image exists
            button Undo icon edit-undo-symbolic invites Undo
            button Redo icon edit-redo-symbolic invites Redo
            button Fit icon zoom-fit-best-symbolic invites FitView when scan.image exists
            button Export emphasized invites ExportRegions when regions not empty
        }

        sidebar {
            group "Source" {
                value scan.source label "Source" fallback "No scan loaded"
                value dimensions(scan.image) label "Dimensions" when scan.image exists
            }
            group "Regions" {
                value count(regions) label "Detected regions"
                button Add invites AddRegion when scan.image exists
                button Delete invites DeleteRegion when selection exists
                value dimensions(item-at(regions, selection)) label "Selected region" when selection exists
            }
            group "Crop" {
                number padding 0..100 label "Padding"
            }
            group "View" {
                value percent(view.zoom) label "Zoom"
            }
        }

        canvas Editor {
            image scan.image
            shapes regions as quads
            focus selection
            view view
            adapt with PreciseEditing

            empty when scan.image absent {
                icon scanner-symbolic
                title "Open or scan an image"
                action "Scan from Scanner…" invites AcquireImage
                action "Open Image…" invites OpenImage
            }

            gesture click shape {
                focus touched
            }
            gesture drag empty {
                pan view
            }
            gesture drag unfocused shape {
                focus touched
                pan view
            }
            gesture drag focused shape {
                use geometry.move
                perceive correction(item) on finish
            }
            gesture drag focused corner {
                use geometry.move-corner
                perceive correction(item) on finish
            }
            gesture drag focused edge {
                use geometry.move-edge
                perceive correction(item) on finish
            }
            gesture wheel {
                zoom view
                perceive zooming
            }
        }
    }
}
