belief user about emotion {
    confident   0.45
    uncertain   0.20
    frustrated  0.05

    never certain
    fades toward neutral over 45s
}

meaning correction(frame) {
    suggests uncertain      gently
    suggests frustrated     faintly
    weakens confident       faintly
}

meaning repeated correction(frame) within 12s {
    suggests frustrated     strongly
    suggests uncertain      moderately
}

meaning undo soon after correction {
    suggests uncertain      strongly
    suggests frustrated     moderately
}

meaning repeated redetection {
    suggests uncertain      strongly
}

meaning detection succeeded and no correction for 20s {
    suggests confident      strongly
    weakens uncertain       moderately
}

meaning export succeeded {
    suggests confident      moderately
    weakens frustrated      gently
}

meaning failure {
    suggests frustrated     moderately
    suggests uncertain      gently
}

pattern user struggles with frame {
    repeated correction(frame)
    or undo soon after correction(frame)
    or correction(frame) after repeated redetection
}

pattern user flows {
    confident dominates uncertain and frustrated
    sustained for 8s
}

offer PreciseEditing {
    magnifier     eager
    handles       generous
    snapping      strong
    hints         subtle
}

withdraw PreciseEditing {
    magnifier     only while dragging
    handles       normal
    snapping      gentle
    hints         hidden
}
