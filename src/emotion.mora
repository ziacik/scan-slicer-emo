belief user about emotion {
    confident 0.45
    uncertain 0.20
    frustrated 0.05
    never certain
}

meaning correction(item) {
    suggests uncertain gently
    suggests frustrated faintly
    weakens confident faintly
}

meaning repeated correction(item) within 12s {
    suggests frustrated strongly
    suggests uncertain moderately
}

meaning undo within 12s after correction(item) {
    suggests uncertain strongly
    suggests frustrated moderately
}

meaning redetection {
    suggests uncertain strongly
}

meaning detection-succeeded {
    suggests confident gently
}

meaning export-succeeded {
    suggests confident moderately
    weakens frustrated gently
}

meaning failure {
    suggests frustrated moderately
    suggests uncertain gently
}

pattern user-struggles {
    repeated correction(item) within 12s
    or undo within 12s after correction(item)
}

pattern user-flows {
    belief user.confident dominates user.uncertain user.frustrated for 8s
}

offer PreciseEditing {
    magnifier eager
    handles 11px
    snapping 24px
}

withdraw PreciseEditing {
    magnifier dragging
    handles 7px
    snapping 0px
}
