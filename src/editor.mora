faculty files from desktop {
    can choose image-file matching ["png", "jpg", "jpeg", "tif", "tiff"]
    can choose folder
}

faculty images from image-codec {
    can load Image from file
    can save Image as png to file
}

desire OpenScan {
    ask user for image-file through files

    fulfilled with file {
        attempt images.load file

        fulfilled with image {
            remember scan as {
                image   image
                source  file
            }
            forget frames
            forget selection
            forget history
            perceive scan arrived
        }

        thwarted by error {
            perceive failure named "open" carrying error
            tell user "Could not open image"
        }
    }
}

desire AddFrame {
    requires scan

    imagine frame centered in scan
        width one third of scan
        height one third of scan

    remember current world in history
    add imagined frame to frames
    focus imagined frame
    perceive user added missing frame
}

desire DeleteFrame {
    requires selection

    remember current world in history
    remove selection from frames
    perceive user deletes detected frame
    forget selection
}

desire Undo {
    requires history has past

    restore previous world
    perceive undo soon after correction when recent correction exists
}

desire Redo {
    requires history has future
    restore next world
}

desire FitView {
    make view fitted
}

desire ExportPhotos {
    requires scan
    requires frames not empty

    ask user for folder through files

    fulfilled with folder {
        attempt {
            for every frame in frames
                perspective-crop scan.image through frame
                save as png into folder numbered by visual order
        }

        fulfilled {
            perceive export succeeded
            tell user "Export finished"
        }

        thwarted by error {
            perceive failure named "export" carrying error
            tell user "Export failed"
        }
    }
}

when user begins moving selected frame {
    remember current world in history
}

when user finishes moving frame {
    perceive correction(frame)
}

when user finishes moving corner of frame {
    perceive correction(frame)
}

when user finishes moving edge of frame {
    perceive correction(frame)
}
