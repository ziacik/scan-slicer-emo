desire AddRegion {
    requires scan.image
    attempt geometry.centered-quad scan.image 0.33 0.33 as region
    snapshot regions selection into history
    add region to regions
    remember selection as last-index regions
}

desire DeleteRegion {
    requires selection
    snapshot regions selection into history
    remove-index selection from regions
    forget selection
}

desire Undo {
    restore previous regions selection from history
    perceive undo
}

desire Redo {
    restore next regions selection from history
}

desire FitView {
    remember view as fitted
}

desire ExportRegions {
    requires scan.image
    requires regions not empty
    ask files.choose-folder as folder {
        title "Export photos"
    }
    for every region in regions {
        attempt geometry.perspective-crop scan.image region as crop
        attempt files.numbered-path folder scan.source index png as target
        attempt images.save crop target
    }
    perceive export-succeeded
    tell user "Export finished"

    on failure {
        perceive failure
        tell user "Export failed"
    }
}
