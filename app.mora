language mora 0.3

bring "src/geometry.mora"
bring "src/emotion.mora"
bring "src/scanner.mora"
bring "src/vision.mora"
bring "src/editor.mora"
bring "src/ui.mora"

app ScanSlicerEmo {
    identity "com.github.ziacik.ScanSlicerEmo"

    starts neutral

    remembers {
        scan        absent
        frames      none
        selection   absent
        history     empty
        padding     0px
        view        fitted
    }

    seeks Editing

    journey Editing {
        toward user.confident
        away from user.frustrated
        away from user.uncertain

        while no scan {
            offer Empty
        }

        when scan arrives {
            desire DetectPhotos
        }

        when user struggles with current frame {
            offer PreciseEditing
        }

        when user flows {
            withdraw PreciseEditing
        }
    }
}
