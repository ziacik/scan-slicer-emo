language mora 0.4

bring "src/emotion.mora"
bring "src/geometry.mora"
bring "src/io.mora"
bring "src/vision.mora"
bring "src/editor.mora"
bring "src/ui.mora"

app ScanSlicerEmo {
    identity "com.github.ziacik.ScanSlicerEmo"
    starts neutral

    remembers {
        scan absent
        regions empty
        selection absent
        history absent
        padding 0
        view fitted
    }

    seeks Editing

    journey Editing {
        toward user.confident
        away from user.frustrated
        away from user.uncertain

        when document-arrived {
            desire DetectRegions
        }

        when user-struggles {
            offer PreciseEditing
        }

        when user-flows {
            withdraw PreciseEditing
        }
    }
}
